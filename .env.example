# Copy to .env and fill in real values locally. Do not commit .env.
# The API reads RCA_* variables (see backend/app/config.py). A .env file
# next to the process working directory is loaded by pydantic-settings.

# Local Docker Postgres from backend/docker-compose.postgres.yml.
# User and password "rca" are for this local container only.
RCA_DATABASE_URL=postgresql+asyncpg://rca:rca@127.0.0.1:5433/rca

# 1 = write traces in the request (201). 0 = queue and return 202.
RCA_INGEST_SYNC=0

# Leave empty for local dev (clients send X-Tenant-ID).
# Example shape only — do not put real keys in git:
# RCA_API_KEYS={"sk_example":"org_demo"}
RCA_API_KEYS=

RCA_JWT_SECRET=
RCA_JWT_ALGORITHM=HS256
RCA_JWT_TENANT_CLAIM=tenant_id
RCA_JWT_ISSUER=
RCA_JWT_AUDIENCE=

RCA_ADMIN_TOKEN=

# Optional object storage. Leave bucket empty to keep trace JSON in Postgres.
RCA_S3_BUCKET=
RCA_S3_ENDPOINT_URL=
RCA_S3_REGION=us-east-1
RCA_S3_ACCESS_KEY_ID=
RCA_S3_SECRET_ACCESS_KEY=
